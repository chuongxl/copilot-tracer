{
  "name": "copilot-tracer",
  "version": "1.0.3",
  "description": "Real-time monitor and tracing tool for GitHub Copilot CLI — tracks tokens, AI credits, MCP/skill/agent calls with console and web UI",
  "keywords": [
    "copilot",
    "github-copilot",
    "tracing",
    "observability",
    "opentelemetry",
    "tokens",
    "ai-credits"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chuongnd/copilot-tracer.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "web/",
    "README.md"
  ],
  "main": "dist/index.js",
  "bin": {
    "copilot-tracer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsx src/cli.ts",
    "console": "tsx src/cli.ts --ui console",
    "web": "tsx src/cli.ts --ui web",
    "start": "node dist/cli.js",
    "publish:npm": "bash scripts/publish.sh"
  },
  "dependencies": {
    "@opentelemetry/otlp-transformer": "^0.221.0",
    "better-sqlite3": "^13.0.2",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.4",
    "commander": "^12.0.0",
    "date-fns": "^3.3.1",
    "express": "^4.18.2",
    "ink": "^5.0.1",
    "ink-table": "^3.0.0",
    "open": "^10.1.0",
    "react": "^18.2.0",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "type": "module"
}
